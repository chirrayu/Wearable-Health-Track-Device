# Local development only. Never commit a filled-in .env file.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./triage_ai.db
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=replace-with-an-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password
# Temporary recovery switch. Set to true for one deploy only, then remove.
RESET_ADMIN_PASSWORD=false

# Optional integrations
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
FIREBASE_CREDENTIALS_JSON=
